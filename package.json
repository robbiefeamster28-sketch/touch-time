{
  "name": "touch-time",
  "version": "1.0.0",
  "private": true,
  "description": "Soccer drills, practices and skill tests: web app plus Android and iPhone apps.",
  "scripts": {
    "build:www": "node scripts/build-www.js",
    "sync": "npm run build:www && npx cap sync",
    "android": "npm run sync && npx cap open android",
    "assets": "npx capacitor-assets generate --iconBackgroundColor '#1f4fd8' --iconBackgroundColorDark '#0a1228' --splashBackgroundColor '#1f4fd8' --splashBackgroundColorDark '#0a1228'"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "8.6.0",
    "@capacitor/share": "8.0.3",
    "@capacitor/splash-screen": "8.0.2"
  },
  "devDependencies": {
    "@capacitor/assets": "4.0.0",
    "@capacitor/cli": "8.6.0"
  }
}
